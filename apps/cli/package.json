{
	"name": "agentpond",
	"version": "0.8.0",
	"description": "Agent-native CLI for local Langfuse-compatible trace analytics",
	"license": "MIT",
	"type": "module",
	"bin": {
		"agentpond": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "tsup",
		"test": "NODE_ENV=test node --test --import tsx tests/*.test.ts",
		"prepack": "node ./scripts/copy-readme.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/marcusschiesser/agentpond.git",
		"directory": "apps/cli"
	},
	"dependencies": {
		"@agentpond/core": "workspace:*",
		"@agentpond/duckdb": "workspace:*",
		"@agentpond/fastify-ingest": "workspace:*",
		"@agentpond/firebase": "workspace:*",
		"@agentpond/files-sdk": "workspace:*",
		"@agentpond/supabase": "workspace:*",
		"@agentpond/vercel": "workspace:*",
		"@azure/storage-blob": "^12.26.0",
		"@aws-sdk/client-s3": "3.1068.0",
		"@aws-sdk/s3-presigned-post": "3.1068.0",
		"@aws-sdk/s3-request-presigner": "3.1068.0",
		"@duckdb/node-api": "^1.5.4-r.1",
		"@google-cloud/storage": "^7.21.0",
		"@inquirer/prompts": "8.5.2",
		"@supabase/storage-js": "2.110.6",
		"commander": "15.0.0",
		"disk": "^0.8.18",
		"fastify": "^5.6.2",
		"files-sdk": "2.2.1",
		"node-appwrite": "^26.0.0",
		"protobufjs": "^7.6.5",
		"skills": "1.5.9",
		"zod": "^4.3.6"
	}
}
